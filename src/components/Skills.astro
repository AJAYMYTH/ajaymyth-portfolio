    case "Socket.IO":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>`;
    case "Claude API":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#d97706]"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`;
    case "OpenRouter":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3b82f6]"><circle cx="12" cy="12" r="3" /><circle cx="12" cy="5" r="3" /><circle cx="5" cy="12" r="3" /><circle cx="19" cy="12" r="3" /><circle cx="12" cy="19" r="3" /></svg>`;
    case "RAG Pipelines":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#a855f7]"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>`;
    case "pgvector":
    case "Supabase Vector":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#3ecf8e]"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" /><path d="M12 2v6" /></svg>`;
    case "AWS":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#ff9900]"><path d="M13.2 16.3c-1.6.4-3.4.6-5.1.6-3.2 0-6.1-1.3-7.5-3.6-.3-.5-.1-.8.4-.7 1.8.3 3.9.4 5.9.4 1.7 0 3.3-.1 5-.4.5-.1.8.3.3.7M21.9 14.8c-.3.4-1.2.6-1.7.6-.4.1-.5-.2-.2-.5.8-.8 1.4-2 1.4-3.4 0-3.3-2.6-6-5.8-6s-5.8 2.7-5.8 6c0 1.9.9 3.6 2.3 4.7.3.2.3.5-.1.7-1.7-1.1-2.7-3.1-2.7-5.4 0-3.9 3.2-7.1 7.1-7.1s7.1 3.2 7.1 7.1c-.1 1.7-.8 3.1-1.6 4M14.8 19.3c.3-.1.4.2.2.4-.7.6-1.5 1-2.4 1.2-.5.1-.6-.2-.3-.4.8-.4 1.7-.8 2.5-1.2"/></svg>`;
    case "Vercel":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-white"><path d="M24 22.525H0L12 1.732l12 20.793z"/></svg>`;
    case "Google Cloud":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#4285f4]"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/></svg>`;
    case "n8n":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#ff6d5a]"><circle cx="12" cy="12" r="3" /><circle cx="6" cy="6" r="3" /><circle cx="18" cy="18" r="3" /><line x1="8.12" y1="8.12" x2="9.88" y2="9.88" /><line x1="14.12" y1="14.12" x2="15.88" y2="15.88" /></svg>`;
    case "GitHub Actions":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2088ff]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>`;
    case "Supabase":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#3ecf8e]"><path d="M21.362 9.354H13.72V1.638A1.637 1.637 0 0 0 11.025.597L2.096 11.233a1.638 1.638 0 0 0 1.242 2.68H10.98v8.444a1.638 1.638 0 0 0 2.808 1.135l9.025-11.385a1.638 1.638 0 0 0-1.451-2.753z"/></svg>`;
    case "PostgreSQL":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#336791]"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" /></svg>`;
    case "Google Drive API":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#34a853]"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>`;
