      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 17V7l7 5-7 5z" /></svg>`;
  }
};

// Row 1 Skills
const row1Skills = [
  ...skillCategories[0].skills, // Languages & Runtime
  ...skillCategories[1].skills  // Frameworks & Libraries
];

// Row 2 Skills
const row2Skills = [
  ...skillCategories[2].skills, // AI / ML
  ...skillCategories[3].skills, // Cloud & DevOps
  ...skillCategories[4].skills  // Databases & Storage
];

// Row 3 Skills
const row3Skills = [
  ...skillCategories[5].skills, // Protocols & Networking
  ...skillCategories[6].skills  // Tools
];
---

<section id="skills" class="py-24 md:py-32 px-6 md:px-12 bg-black border-t border-border overflow-hidden">
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <div class="fade-in-up flex items-center gap-2">
      <span class="font-mono text-xs text-text-muted">// 02.</span>
      <h2 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Skills &amp; Toolkit</h2>
    </div>

    <!-- Intro Text -->
    <div class="fade-in-up max-w-2xl">
      <h3 class="text-2xl sm:text-3xl font-sans font-bold text-white tracking-tight leading-tight mb-4">
        A Compiled Stack of Modern Engineering
      </h3>
      <p class="font-sans text-sm text-text-secondary leading-relaxed font-normal">
        Continuous scrolling ribbons displaying languages, developer tools, custom protocols, database engines, and AI workflow automation integrations.
      </p>
    </div>

    <!-- Scrolling Marquees Grid -->
    <div class="fade-in-up pt-8 space-y-8 relative">
      
      <!-- Row 1: Slides Left -->
      <div class="relative flex overflow-hidden select-none w-full gap-0 mask-fade">
        <div class="flex gap-6 min-w-full shrink-0 items-center justify-start pr-6 animate-marquee hover:[animation-play-state:paused] cursor-pointer">
          {row1Skills.map((skill) => (
            <div class="inline-flex items-center gap-3.5 px-6 py-3.5 bg-bg-surface border border-border hover:border-border-hover rounded-2xl select-none transition-colors duration-200">
              <span set:html={getIconSvg(skill.name)}></span>
              <span class="font-sans text-sm md:text-base font-bold text-white tracking-tight">{skill.name}</span>
            </div>
          ))}
        </div>
        <div class="flex gap-6 min-w-full shrink-0 items-center justify-start pr-6 animate-marquee hover:[animation-play-state:paused] cursor-pointer" aria-hidden="true">
          {row1Skills.map((skill) => (
            <div class="inline-flex items-center gap-3.5 px-6 py-3.5 bg-bg-surface border border-border hover:border-border-hover rounded-2xl select-none transition-colors duration-200">
              <span set:html={getIconSvg(skill.name)}></span>
              <span class="font-sans text-sm md:text-base font-bold text-white tracking-tight">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>

