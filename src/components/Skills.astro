---
// Skills.astro
import { skillCategories } from "../data/skills";

// Helper function to return high-quality brand-specific SVGs based on skill name
const getIconSvg = (skillName: string) => {
  switch (skillName) {
    case "JavaScript":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#f7df1e]"><path d="M0 0h24v24H0V0zm22.034 18.268c-.175-1.095-.888-2.015-3.003-2.87-1.152-.452-1.956-.705-1.956-1.348 0-.438.35-.767.97-.767.796 0 1.307.423 1.482 1.11H22c-.22-2.11-1.555-3.32-3.524-3.32-2.21 0-3.723 1.146-3.723 3.146 0 2.438 1.95 2.868 3.86 3.657 1.3.504 1.97.818 1.97 1.54 0 .526-.482.905-1.27.905-1.168 0-1.81-.59-1.986-1.57h-2.524c.248 2.504 1.803 3.32 4.31 3.32 2.62 0 4.022-1.22 4.022-3.313zm-12.013-.732c-.117-.686-.336-1.138-.89-1.394-.482-.227-.89-.314-1.686-.314-.818 0-1.124.168-1.285.518-.182.4-.182.89-.182 2.146 0 1.234 0 1.73.182 2.11.16.365.518.525 1.343.525.803 0 1.146-.175 1.336-.59.182-.394.182-.876.182-2.146V15h2.526v5.35c0 1.547-.073 2.21-.306 2.868-.416 1.182-1.46 1.782-3.664 1.782-1.832 0-3.153-.54-3.693-1.43-.277-.46-.38-1.073-.41-2.277h2.526c.036.708.146.992.38 1.204.314.285.876.386 1.408.386.868 0 1.292-.24 1.482-.876.102-.343.117-.898.117-2.036V17.536z"/></svg>`;
    case "TypeScript":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#3178c6]"><path d="M0 0h24v24H0V0zm10.567 17.53c0 .876-.11 1.43-.336 1.78-.41.657-1.277.92-2.525.92-1.78 0-2.876-.576-3.27-1.48-.19-.44-.24-1.023-.24-2.278h2.373c.015.65.11 1.015.285 1.198.24.256.686.35 1.117.35.657 0 1.008-.182 1.168-.584.095-.24.11-.635.11-1.547V8h2.525v9.53zm9.052-4.043c-.153-.94-.78-1.737-2.62-2.474-1.008-.4-1.708-.62-1.708-1.182 0-.387.307-.67.854-.67.7 0 1.146.365 1.3 1.01h2.2v-.22c-.2-1.847-1.358-2.9-3.08-2.9-1.927 0-3.255 1.007-3.255 2.76 0 2.13 1.7 2.503 3.372 3.197 1.138.44 1.722.715 1.722 1.343 0 .46-.423.79-1.11.79-1.022 0-1.584-.518-1.737-1.372h-2.2c.21 2.182 1.57 2.9 3.77 2.9 2.292 0 3.518-1.066 3.518-2.9z"/></svg>`;
    case "React":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="text-[#61dafb]"><ellipse cx="12" cy="12" rx="11" ry="4.2" /><ellipse cx="12" cy="12" rx="11" ry="4.2" transform="rotate(60 12 12)" /><ellipse cx="12" cy="12" rx="11" ry="4.2" transform="rotate(120 12 12)" /><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>`;
    case "Node.js":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#339933]"><path d="M12 .008L1.642 6v11.984L12 23.992l10.358-6.008V6.008L12 .008zm8.358 16.79l-8.358 4.846-8.358-4.846V7.194l8.358-4.846 8.358 4.846v9.604z"/></svg>`;
    case "Python":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#3776ab]"><path d="M11.927 0C5.352 0 5.568 2.857 5.568 2.857L5.586 5.86H12.01V6.7H3.04S0 6.643 0 12.036c0 5.393 2.65 5.228 2.65 5.228h1.587v-2.224s-.044-2.658 2.613-2.658h5.056c2.658 0 2.502-2.316 2.502-2.316V4.18s.117-4.18-2.482-4.18zm-3.48 1.954a.735.735 0 1 1 0 1.47a.735.735 0 0 1 0-1.47zm8.441 3.513c-2.658 0-2.502 2.316-2.502 2.316v5.856s-.117 4.18 2.482 4.18c6.575 0 6.359-2.857 6.359-2.857l-.018-3.003H16.8v-.84h8.97S24 11.236 24 5.843c0-5.393-2.65-5.228-2.65-5.228h-1.587v2.224s.044 2.658-2.613 2.658h-5.056zm3.48 16.579a.735.735 0 1 1 0-1.47a.735.735 0 0 1 0 1.47z"/></svg>`;
    case "HTML/CSS":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#e34f26]"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`;
    case "Vite":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#646cff]"><path d="M22.414 3.062a1 1 0 0 0-.756-.913L12 .4 2.342 2.149a1 1 0 0 0-.756.913L1.042 12.3a1 1 0 0 0 .47.886l9.958 5.753V23a1 1 0 0 0 2 0v-4.061l9.958-5.753a1 1 0 0 0 .47-.886l-.484-9.238zm-11.456 12.6l-6.3-3.642 10.37-3.805-4.07 7.447z"/></svg>`;
    case "Astro.js":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#ff5a00]"><path d="M12 2L2 22h20L12 2z" /><path d="M12 18v-8M9 14l3-3 3 3" /></svg>`;
    case "Express.js":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/80"><rect x="2" y="2" width="20" height="8" rx="2" /><rect x="2" y="14" width="20" height="8" rx="2" /><line x1="6" y1="6" x2="6" y2="6" /><line x1="6" y1="18" x2="6" y2="18" /></svg>`;
