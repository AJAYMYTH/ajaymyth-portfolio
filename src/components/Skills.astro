    case "Figma (basic)":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#f24e1e]"><path d="M8 24a5 5 0 0 1-5-5 5 5 0 0 1 5-5h5v5a5 5 0 0 1-5 5zm0-10a5 5 0 0 1-5-5 5 5 0 0 1 5-5h5v10H8zm5-10a5 5 0 0 1 5-5 5 5 0 0 1 5 5 5 5 0 0 1-5 5h-5V4zm0 10a5 5 0 0 1 5-5 5 5 0 0 1 5 5 5 5 0 0 1-5 5h-5v-5zm0 10a5 5 0 0 1 5-5 5 5 0 0 1 5 5 5 5 0 0 1-5 5h-5v-5z"/></svg>`;
