      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#e02424]"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>`;
    case "TLS":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#10b981]"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>`;
    case "Git":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#f05032]"><path d="M23.546 10.93L13.067.452a1.644 1.644 0 0 0-2.327 0L8.76 2.43l3.182 3.182a1.637 1.637 0 0 1 2.257 2.257l3.075 3.075a1.645 1.645 0 0 1-.031 2.291l-3.28 3.28a1.644 1.644 0 0 1-2.29.031l-3.075-3.075a1.637 1.637 0 0 1-2.257-2.257l-3.18-3.18L.452 13.066a1.644 1.644 0 0 0 0 2.327l10.479 10.479a1.644 1.644 0 0 0 2.327 0l10.288-10.288a1.644 1.644 0 0 0 0-2.654zM9 12a1 1 0 1 1-1-1 1 1 0 0 1 1 1zm8.7 3.7a1 1 0 1 1-1-1 1 1 0 0 1 1 1z"/></svg>`;
    case "GitHub":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-white"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`;
    case "VS Code":
      return `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" class="text-[#007acc]"><path d="M23.15 2.587L18.21.105a1.478 1.478 0 0 0-1.7.255L11.9 4.17 3.658.263a1.071 1.071 0 0 0-1.422.48L.105 5.4a1.07 1.07 0 0 0 .446 1.378l4.475 2.4-4.475 2.4a1.07 1.07 0 0 0-.446 1.378l2.13 4.658a1.07 1.07 0 0 0 1.422.48l8.243-3.907 4.607 3.81a1.478 1.478 0 0 0 1.7.255l4.94-2.482A1.478 1.478 0 0 0 24 16.9V4.67a1.478 1.478 0 0 0-.85-1.383z"/></svg>`;
