---
// Contact.astro
---

<section id="contact" class="py-24 md:py-32 px-6 md:px-12 bg-black border-t border-border relative overflow-hidden">
  <!-- Backdrop glow -->
  <div class="absolute right-0 bottom-0 w-[400px] h-[400px] bg-accent-cyan/5 rounded-full blur-[120px] pointer-events-none z-0"></div>

  <div class="max-w-5xl mx-auto z-10 relative">
    <!-- Header -->
    <div class="fade-in-up flex items-center gap-2 mb-12">
      <span class="font-mono text-xs text-text-muted">// 05.</span>
      <h2 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Contact</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-10 gap-12 md:gap-16 items-start">
      <!-- Left Column: Direct Links (40% / 4 columns) -->
      <div class="md:col-span-4 space-y-6 fade-in-up">
        <div>
          <h3 class="text-3xl sm:text-4xl font-sans font-bold text-white tracking-tight leading-none mb-4">
            Let's build something.
          </h3>
          <p class="font-sans text-sm text-text-secondary leading-relaxed font-normal">
            Available for collaborations and internships. Drop an email or connect on social platforms.
          </p>
        </div>

        <!-- Links List -->
        <div class="space-y-4 font-mono text-xs pt-4 border-t border-border/50 select-none">
          <a href="https://github.com/AJAYMYTH" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 bg-bg-surface border border-border hover:border-border-hover hover:text-white rounded-lg text-text-secondary transition-all">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span>GitHub</span>
            </span>
            <span class="text-text-muted">github.com/AJAYMYTH ↗</span>
          </a>
          <a href="https://www.npmjs.com/package/afterlink" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 bg-bg-surface border border-border hover:border-border-hover hover:text-white rounded-lg text-text-secondary transition-all">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
              <span>npm registry</span>
            </span>
            <span class="text-text-muted">package/afterlink ↗</span>
          </a>
          <a href="https://orcid.org/0009-0000-4829-6726" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 bg-bg-surface border border-border hover:border-border-hover hover:text-white rounded-lg text-text-secondary transition-all">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span>ORCID Record</span>
            </span>
            <span class="text-text-muted">0009-0000-4829-6726 ↗</span>
          </a>
          <a href="https://www.linkedin.com/in/javaliajayakumar" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 bg-bg-surface border border-border hover:border-border-hover hover:text-white rounded-lg text-text-secondary transition-all">
            <span class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              <span>LinkedIn</span>
            </span>
            <span class="text-text-muted">javaliajayakumar ↗</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Contact Form (60% / 6 columns) -->
      <div class="md:col-span-6 fade-in-up w-full">
        <form 
          action="https://formsubmit.co/javaliajayakumar8574@gmail.com" 
          method="POST" 
          id="contact-form"
          class="space-y-6"
        >
          <!-- Anti-Spam / Captcha Bypass Configuration -->
          <input type="hidden" name="_captcha" value="false">
          
          <!-- Name Input -->
          <div class="space-y-2">
            <label for="form-name" class="block font-mono text-[10px] uppercase tracking-wider text-text-secondary">Name</label>
            <input 
              type="text" 
              name="name" 
              id="form-name" 
              required
              placeholder="Your name"
              class="w-full bg-bg-surface border border-border hover:border-border-hover focus:border-accent-cyan rounded-lg px-4 py-3 text-sm text-white placeholder-text-muted focus:outline-none transition-colors"
            />
          </div>

          <!-- Email Input -->
          <div class="space-y-2">
            <label for="form-email" class="block font-mono text-[10px] uppercase tracking-wider text-text-secondary">Email Address</label>
            <input 
              type="email" 
              name="email" 
              id="form-email" 
              required
              placeholder="you@example.com"
              class="w-full bg-bg-surface border border-border hover:border-border-hover focus:border-accent-cyan rounded-lg px-4 py-3 text-sm text-white placeholder-text-muted focus:outline-none transition-colors"
            />
          </div>

          <!-- Message Input -->
          <div class="space-y-2">
            <label for="form-message" class="block font-mono text-[10px] uppercase tracking-wider text-text-secondary">Message</label>
            <textarea 
              name="message" 
              id="form-message" 
              rows="5"
              required
              placeholder="Write your message here..."
              class="w-full bg-bg-surface border border-border hover:border-border-hover focus:border-accent-cyan rounded-lg px-4 py-3 text-sm text-white placeholder-text-muted focus:outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Success Alert -->
          <div id="contact-success" class="hidden p-4 bg-[#0a2f1d] border border-[#10b981]/30 text-[#10b981] rounded-lg text-sm flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <p class="font-bold text-white mb-0.5">Message Sent Successfully!</p>
              <p class="text-[#a7f3d0] text-xs">Thank you for reaching out. Ajay will get back to you shortly.</p>
            </div>
          </div>

          <!-- Error Alert -->
          <div id="contact-error" class="hidden p-4 bg-[#2d0f11] border border-[#ef4444]/30 text-[#ef4444] rounded-lg text-sm flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>
              <p class="font-bold text-white mb-0.5">Oops, something went wrong.</p>
              <p class="text-[#fecaca] text-xs">Please try again or contact me directly via email.</p>
            </div>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="contact-submit"
            class="px-8 py-3.5 bg-white text-black font-sans font-medium rounded-full hover:bg-white/90 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-md flex items-center justify-center gap-2 group text-sm w-full sm:w-auto cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="submit-text">Send Message</span>
            <svg id="submit-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-200"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit');
    const successAlert = document.getElementById('contact-success');
    const errorAlert = document.getElementById('contact-error');
    const submitText = document.getElementById('submit-text');
    const submitIcon = document.getElementById('submit-icon');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Hide previous alerts
        if (successAlert) successAlert.classList.add('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');
        
        // Disable button & change text to loading
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = "Sending...";
        if (submitIcon) submitIcon.classList.add('animate-pulse');

        const formData = new FormData(form);
        const payload = {
          name: formData.get('name'),
          email: formData.get('email'),
          message: formData.get('message')
        };

        try {
          const response = await fetch("https://formsubmit.co/ajax/javaliajayakumar8574@gmail.com", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (response.ok && result.success === "true") {
            if (successAlert) successAlert.classList.remove('hidden');
            form.reset();
          } else {
            throw new Error('Form submission failed');
          }
        } catch (err) {
          if (errorAlert) errorAlert.classList.remove('hidden');
        } finally {
          // Re-enable button
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.textContent = "Send Message";
          if (submitIcon) submitIcon.classList.remove('animate-pulse');
        }
      });
    }
  });
</script>
