---
import { StatCounter } from "../StatCounter";
// AfterLinkCard.astro
---

<div class="relative w-full bg-bg-surface border border-border rounded-xl p-6 sm:p-8 hover:border-accent-cyan hover:shadow-[0_0_40px_rgba(0,216,255,0.12)] transition-all duration-300 group overflow-hidden">
  <!-- Subtle noise/diagonal texture effect -->
  <div class="absolute inset-0 opacity-[0.015] bg-[linear-gradient(45deg,#888_25%,transparent_25%),linear-gradient(-45deg,#888_25%,transparent_25%),linear-gradient(45deg,transparent_75%,#888_75%),linear-gradient(-45deg,transparent_75%,#888_75%)] bg-[size:20px_20px] pointer-events-none"></div>

  <!-- Glow element that fades in on hover -->
  <div class="absolute -inset-px bg-gradient-to-r from-accent-cyan/10 to-transparent rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>

  <div class="relative z-10 flex flex-col justify-between h-full">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <span class="text-xl sm:text-2xl font-sans font-bold text-white tracking-tight">AfterLink</span>
        <span class="px-2 py-0.5 font-mono text-[10px] bg-accent-cyan/10 text-accent-cyan border border-accent-cyan/20 rounded-md">v1.2.1</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1 bg-white/5 border border-white/10 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan animate-pulse"></span>
        <span class="font-mono text-[9px] uppercase tracking-wider text-text-secondary">Featured Protocol</span>
      </div>
    </div>

    <!-- Description -->
    <p class="font-sans text-sm sm:text-base text-text-secondary leading-relaxed mb-8 max-w-3xl">
      A custom application-layer binary TCP protocol for Node.js. Built to solve high-frequency data transmission issues with 10-byte frame headers, persistent connections, native pub/sub routing, strict Zod schema validation, and sub-1ms latency under load.
    </p>

    <!-- Stats Grid (Using React Island for count-up animation) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <StatCounter client:visible end={30167} suffix="" label="msg/sec throughput" />
      <StatCounter client:visible end={0.033} suffix="ms" label="avg latency" decimals={3} />
      <StatCounter client:visible end={76} suffix="%" label="faster than ws" />
      <StatCounter client:visible end={10} suffix="B" label="fixed header size" />
    </div>

    <!-- Tags Row -->
    <div class="flex flex-wrap gap-2 mb-8 select-none">
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#binary-protocol</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#nodejs</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#real-time</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#pub-sub</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#tcp-socket</span>
    </div>

    <!-- CTA & Copy command row -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-border pt-6">
      <!-- Copy command button -->
      <button 
        id="npm-copy-btn" 
        data-copy-text="npm install afterlink" 
        class="flex items-center justify-between gap-4 px-4 py-2.5 bg-black border border-border hover:border-border-hover rounded-lg font-mono text-xs text-text-secondary hover:text-white transition-all cursor-pointer group/btn"
      >
        <span class="flex items-center gap-2">
          <span class="text-accent-cyan select-none">$</span>
          <span>npm install afterlink</span>
        </span>
        <span class="relative w-4 h-4 flex items-center justify-center">
          <svg id="copy-icon" class="w-4 h-4 text-text-muted group-hover/btn:text-text-secondary transition-colors" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg id="check-icon" class="w-4 h-4 text-accent-cyan hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
      </button>

      <!-- Links -->
      <div class="flex items-center justify-end gap-6 text-sm">
        <a href="/projects/afterlink" class="text-text-secondary hover:text-white transition-colors font-medium flex items-center gap-1">
          Docs
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
        <a href="https://github.com/AJAYMYTH/AfterLink" target="_blank" rel="noopener noreferrer" class="text-accent-cyan hover:underline font-medium flex items-center gap-1">
          GitHub
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('npm-copy-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn.getAttribute('data-copy-text');
    if (text) {
      try {
        await navigator.clipboard.writeText(text);
        
        // Show success visual state
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        copyBtn.classList.add('border-accent-cyan/40');
        
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          copyBtn.classList.remove('border-accent-cyan/40');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    }
  });
</script>
