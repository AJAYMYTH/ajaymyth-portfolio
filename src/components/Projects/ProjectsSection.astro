---
import { projects } from "../../data/projects";
import AfterLinkCard from "./AfterLinkCard.astro";
import ProjectCard from "./ProjectCard.astro";

const featuredProject = projects.find(p => p.isFeatured);
const secondaryProjects = projects.filter(p => !p.isFeatured);
---

<section id="projects" class="py-24 md:py-32 px-6 md:px-12 bg-black border-t border-border">
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <div class="fade-in-up flex items-center gap-2">
      <span class="font-mono text-xs text-text-muted">//</span>
      <h2 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Projects</h2>
    </div>

    <!-- Featured Project Section -->
    <div class="fade-in-up space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan"></span>
        <span class="text-xs uppercase font-mono tracking-wider text-text-secondary">Core Masterpiece</span>
      </div>
      {featuredProject && <AfterLinkCard />}
    </div>

    <!-- Grid Header -->
    <div class="fade-in-up pt-12 border-t border-border/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h3 class="text-xl font-sans font-bold text-white tracking-tight">Other Engineered Solutions</h3>
        <p class="text-xs text-text-secondary font-mono mt-1">Experimental tools, automation, and AI applications</p>
      </div>
    </div>

    <!-- Secondary Projects Grid -->
    <div class="fade-in-up grid grid-cols-1 md:grid-cols-2 gap-6">
      {secondaryProjects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>
