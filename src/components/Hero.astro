---
// Hero.astro
import { InteractiveGridBackground } from "./InteractiveGridBackground";
import { LoopingWords } from "./LoopingWords";

const heroWords = [
  "Developer",
  "AfterLink Creator",
  "AIML Student",
  "Open Source Builder",
  "AWS Competitor"
];
---

<section id="hero" class="relative min-h-screen bg-black overflow-hidden select-none">
  <InteractiveGridBackground client:load className="min-h-screen w-full flex flex-col justify-center items-center py-20 px-6" fadeIntensity={20}>
    <!-- Radial gradient pulse glow background -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[800px] md:h-[800px] pointer-events-none z-0">
      <div class="w-full h-full bg-[radial-gradient(circle,rgba(0,216,255,0.08)_0%,rgba(0,0,0,0)_70%)] rounded-full pulse-glow-bg"></div>
    </div>

    <div class="max-w-4xl mx-auto flex flex-col items-center text-center z-10 relative">
      <!-- Badge pill -->
      <div class="fade-in-up hero-stagger-1 inline-flex items-center gap-2 px-3 py-1 bg-bg-surface border border-border hover:border-border-hover transition-colors rounded-full mb-8">
        <span class="w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></span>
        <span class="font-mono text-xs text-text-secondary tracking-wide uppercase">
          AIML Developer · Diploma Student · Karnataka, India
        </span>
      </div>

      <!-- Name Javali Ajayakumar with staggered word reveal -->
      <h1 class="text-[clamp(2.5rem,8vw,5.5rem)] font-sans font-bold leading-tight tracking-[-0.03em] text-white max-w-4xl mb-6">
        <span class="inline-block opacity-0 translate-y-6 animate-reveal">Javali</span>
        <span class="inline-block opacity-0 translate-y-6 animate-reveal delay-100 text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-accent-cyan">Ajayakumar</span>
      </h1>

      <!-- Looping words animation -->
      <div class="fade-in-up hero-stagger-2 w-full max-w-xl mx-auto mb-8 flex justify-center">
        <LoopingWords client:load words={heroWords} />
      </div>

      <!-- Tagline -->
      <p class="fade-in-up hero-stagger-3 text-lg sm:text-xl font-sans text-text-secondary max-w-2xl mb-10 leading-relaxed font-normal">
        I build AI-powered apps, real-time protocols, and developer tools that actually ship.
      </p>

      <!-- CTA Row -->
      <div class="fade-in-up hero-stagger-4 flex flex-col sm:flex-row gap-4 mb-16 justify-center w-full sm:w-auto">
        <a href="#projects" class="px-8 py-3.5 bg-white text-black font-sans font-medium rounded-full hover:bg-white/90 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-[0_4px_20px_rgba(255,255,255,0.15)] flex items-center justify-center gap-2 group text-sm">
          View Projects
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-200"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="/resume.pdf" download class="px-8 py-3.5 border border-border bg-bg-surface text-white font-sans font-medium rounded-full hover:bg-bg-elevated hover:border-white/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 text-sm">
          Download Resume
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </a>
      </div>

      <!-- Stat Row -->
      <div class="fade-in-up hero-stagger-4 w-full max-w-2xl border-t border-b border-border py-6 grid grid-cols-2 md:flex md:flex-row md:justify-around gap-6 select-none">
        <div class="flex flex-col items-center px-4">
          <span class="font-mono text-2xl md:text-3xl font-bold text-white tracking-tight">19</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">Repositories</span>
        </div>
        <div class="flex flex-col items-center px-4 border-l border-border md:border-l-0">
          <span class="font-mono text-2xl md:text-3xl font-bold text-white tracking-tight">2</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">npm Packages</span>
        </div>
        <div class="flex flex-col items-center px-4 border-t border-border pt-4 md:pt-0 md:border-t-0 md:border-l md:border-border">
          <span class="font-mono text-2xl md:text-3xl font-bold text-white tracking-tight">3</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">AI Apps</span>
        </div>
        <div class="flex flex-col items-center px-4 border-t border-border pt-4 md:pt-0 md:border-t-0 border-l border-border">
          <span class="font-mono text-2xl md:text-3xl font-bold text-white tracking-tight">1</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">Custom Protocol</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 cursor-pointer z-10 opacity-70 hover:opacity-100 transition-opacity">
      <a href="#about" aria-label="Scroll down">
        <svg class="w-6 h-6 text-text-secondary animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </InteractiveGridBackground>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-reveal {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 {
    animation-delay: 150ms;
  }
</style>
